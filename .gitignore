# The real pipeline output is committed so the design side can use it (~11 MB).
!data/processed/site-data/
*.nc
*.hdf
*.h5
*.tif
*.tiff

# Mock binaries (regenerate with contract/mock/generate_mock.py)
contract/mock/data/**/*.bin
contract/mock/data/**/*.bin.gz
.pytest_cache/
