{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Base map descriptor (basemap.json)",
  "type": "object",
  "required": ["schema_version", "mock", "image", "extent_m", "pixel_size_m", "width_px", "height_px", "source"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "mock": {"type": "boolean"},
    "image": {"type": "string"},
    "extent_m": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "[xmin, ymin, xmax, ymax] outer edges"},
    "pixel_size_m": {"type": "number", "exclusiveMinimum": 0},
    "width_px": {"type": "integer", "minimum": 1},
    "height_px": {"type": "integer", "minimum": 1},
    "source": {"type": "string"}
  }
}
